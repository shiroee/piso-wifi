# Replace the value with a long unique random secret.
PISOWIFI_ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET
PISOWIFI_DB=/var/lib/pisowifi/credits.sqlite3
PISOWIFI_MINUTES_PER_PESO=5
PISOWIFI_BIND=127.0.0.1
PISOWIFI_PORT=8090
# Set true only after openNDS/ndsctl behavior is tested and integration reviewed.
# The customer portal needs it: it's what lets paid phones onto the internet.
PISOWIFI_ENABLE_NDS_AUTH=false
# Insert Coin window: seconds a customer keeps the coinslot after tapping
# Insert Coin or inserting a coin.
PISOWIFI_COIN_WINDOW_SECONDS=60
# Seconds after a window ends (or Done is tapped) during which a coin that is
# still being counted is credited to that customer. Keep at least 5.
PISOWIFI_COIN_GRACE_SECONDS=5
# Owner dashboard (admin/dashboard.py). Open http://<Pi WAN address>:8091 from
# your home network. pisowifi-guard blocks this port from the customer LAN.
# Set the login password with: dashboard.py set-password
PISOWIFI_DASHBOARD_BIND=0.0.0.0
PISOWIFI_DASHBOARD_PORT=8091
# Customer portal (portal/portal.py). openNDS sends unpaid phones here.
# Starting name; "Name and look" on the dashboard overrides it.
PISOWIFI_PORTAL_NAME="Piso WiFi"
PISOWIFI_PORTAL_BIND=10.20.0.1
PISOWIFI_PORTAL_PORT=2080
# Address the portal tells customers to open to check their time.
PISOWIFI_PORTAL_ADDRESS=http://piso.wifi
# Portal language customers see first: en (English) or tl (Tagalog). They can switch.
PISOWIFI_PORTAL_LANGUAGE=en
# Starting speed limits per customer in kilobits per second (0 = no limit).
# The dashboard's "Rate and coinslot" settings override these.
PISOWIFI_DOWNLOAD_KBPS=0
PISOWIFI_UPLOAD_KBPS=0
# Coin slot light on the Allan board: line 11 = PA11 = header pin 5 (measured:
# 11.6 V on the CS LED connector when the line is high). Leave empty for no light.
# Set COIN_LED_ACTIVE_LOW=1 only if your light turns on when the line is low.
COIN_LED_LINE=11
COIN_LED_ACTIVE_LOW=0
